{
  "name": "@classytic/referral",
  "version": "0.2.1",
  "description": "Referral ATTRIBUTION engine — shareable codes, who-referred-whom, conversion tracking, dedupe + self-referral guard. Single responsibility: it answers 'who drove this sale', NOT money (that's @classytic/revenue) or points (that's @classytic/loyalty). Powered by @classytic/mongokit.",
  "author": "Classytic",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "@classytic/source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./events": {
      "@classytic/source": "./src/events/event-catalog.ts",
      "types": "./dist/events/event-catalog.d.mts",
      "default": "./dist/events/event-catalog.mjs"
    },
    "./schemas/*": {
      "@classytic/source": "./src/schemas/*.ts",
      "types": "./dist/schemas/*.d.mts",
      "default": "./dist/schemas/*.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit --project integration",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest --project unit --project integration",
    "test:all": "vitest run",
    "prepublishOnly": "npm run typecheck && npm run build",
    "push": "classytic-push"
  },
  "peerDependencies": {
    "@classytic/mongokit": ">=3.41.0",
    "@classytic/primitives": ">=0.31.1",
    "@classytic/repo-core": ">=0.31.0",
    "mongoose": ">=9.11.0",
    "zod": ">=4.0.0"
  },
  "devDependencies": {
    "@classytic/dev-tools": "^0.2.0",
    "@classytic/mongokit": "^3.41.0",
    "@classytic/primitives": ">=0.31.1",
    "@classytic/repo-core": ">=0.31.0",
    "@types/node": "^22.19.21",
    "@vitest/coverage-v8": "^4.1.9",
    "mongodb-memory-server": "^11.2.0",
    "mongoose": "^9.11.1",
    "publint": "^0.3.23",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9",
    "zod": "^4.3.6"
  },
  "keywords": [
    "referral",
    "affiliate",
    "attribution",
    "refer-a-friend",
    "invite",
    "conversion",
    "mongokit",
    "classytic"
  ]
}
